{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "youtrack": {
        "type": "remote",
        "url": "https://usi-desarrollo.youtrack.cloud/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/youtrack-token}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "n8n-mcp": {
        "type": "remote",
        "url": "https://usi-n8n.slp.gob.mx/mcp-server/http",
        "oauth": false,
        "headers": {
          "Authorization": "{file:~/.config/opencode/secrets/n8n-mcp-auth}"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "angular-cli": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@angular/cli",
          "mcp"
        ]
      }
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "{env:LMSTUDIO_API_KEY}"
      },
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3-4b-Instruct (local)"
        }
      }
    }
  },
  "plugin": [
    "opencode-omniroute-auth"
  ],
  "theme": "system",
  "autoupdate": false
}
