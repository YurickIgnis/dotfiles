{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-omniroute-auth"
  ],
  "provider": {
    "lmstudio": {
      "name": "LM Studio (local)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3-4b-Instruct (local)"
        }
      },
      "options": {
        "apiKey": "{env:LMSTUDIO_API_KEY}",
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  },
  "mcp": {
    "youtrack": {
      "type": "remote",
      "url": "https://usi-desarrollo.youtrack.cloud/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "{env:YOUTRACK_TOKEN}"
      },
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "n8n-mcp": {
      "type": "remote",
      "url": "https://usi-n8n.slp.gob.mx/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "{env:N8N_API_KEY}"
      },
      "oauth": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "excalidraw": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "EXPRESS_SERVER_URL=http://host.docker.internal:3000",
        "-e",
        "ENABLE_CANVAS_SYNC=true",
        "ghcr.io/yctimlin/mcp_excalidraw:latest"
      ],
      "enabled": true
    },
    "angular-cli": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/cli",
        "mcp"
      ],
      "enabled": true
    }
  }
}
